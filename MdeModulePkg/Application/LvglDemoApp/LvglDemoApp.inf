## @file
#  lvgl Demo Application — P1 milestone: validate LvglLib GOP rendering and keyboard input
##

[Defines]
  INF_VERSION    = 0x00010005
  BASE_NAME      = LvglDemoApp
  FILE_GUID      = A1B2C3D4-E5F6-7890-ABCD-EF1234567891
  MODULE_TYPE    = UEFI_APPLICATION
  VERSION_STRING = 1.0
  ENTRY_POINT    = UefiMain

[Sources]
  LvglDemoApp.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec

[LibraryClasses]
  UefiApplicationEntryPoint
  UefiBootServicesTableLib
  PrintLib
  LvglLib

[BuildOptions]
  GCC:*_*_*_CC_FLAGS = -I$(WORKSPACE)/MdeModulePkg/Library/LvglLib -I$(WORKSPACE)/MdeModulePkg/Library/LvglLib/lvgl -DLV_CONF_INCLUDE_SIMPLE
